# Makefile build target
build/

# Object files and binaries
*.o
*.elf
*.bin
*.hex
*.map
*.lst
*.su

# Editor/IDE specific
.vscode/
.cache/
compile_commands.json
*.swp

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Markdown document template
*.md.tmp
NAMING.md

# Debug tool
.gdbinit
openocd.cfg
emulator-command.md

# CMSIS from ARM
CMSIS/Include/*

# Exclude CMSIS for the Board
!CMSIS/Include/cmsis_version.h
!CMSIS/Include/cmsis_gcc.h
!CMSIS/Include/cmsis_compiler.h
!CMSIS/Include/mpu_armv7.h
!CMSIS/Include/core_cm4.h
